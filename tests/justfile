# znet test suite (C89-friendly, no external test framework).
#
# Normally driven from the repo root: `just check`, `just test tcp`, `just cov`
# (the root justfile imports this directory as a module, so `just tests check`
# works too).  This file can also be used directly:
#
#   just --justfile tests/justfile test tcp     # one suite, native backend
#   just --justfile tests/justfile check-select # same suites with ZN_USE_SELECT
#
# Every check build uses ASan+UBSan by default.  Test sources live in
# tests/<suite>.c; misc/gen_entries.lua turns the TEST(name) functions into the
# entries table and main().

set windows-shell := ["cmd.exe", "/C"]

ROOT     := source_directory() / ".."
SRC      := source_directory()
BUILD    := source_directory() / "build"
TEST_LUA := SRC / "test.lua"

CC  := env("CC", "cc")
CXX := env("CXX", "c++")
LUA := env("LUA", "lua")

# Defines the generator needs but the compiler already knows: the suites use
# the platform switches to select backend-specific cases.  Keep this in sync
# with tests/README.md ("conditional compilation").
GEN_DEFS := if os() == "macos" {
    "-DZN_HAVE_KQUEUE"
} else if os() == "linux" {
    "-D__linux__"
} else if os() == "windows" {
    "-D_WIN32"
} else {
    ""
}

WARN := "-Wall -Wextra -Werror -Wno-unused-parameter -pedantic"
INC  := "-I" + ROOT + " -I" + source_directory()
BASE := "-std=c99 -D_XOPEN_SOURCE=600 " + WARN + " " + INC
SAN  := "-g -O0 -fsanitize=address,undefined -fno-sanitize-recover=undefined"

# every suite; generated runners are built from these names
SUITES := "mempool_test timer_test addr_test addrinfo_test state_test resultqueue_test tcp_test dispatch_test udp_test lifecycle_test buffer_test"

default: check

# ---------------------------------------------------------------------------
# builds

[unix]
[private]
build tag flags suites=SUITES:
    #!/usr/bin/env bash
    set -euo pipefail
    out='{{BUILD}}/{{tag}}'
    mkdir -p "$out"
    for s in {{suites}}; do
        {{LUA}} '{{ROOT}}/misc/gen_entries.lua' \
            "{{SRC}}/$s.c" "{{SRC}}/$s.gen.inc" {{flags}} {{GEN_DEFS}}
        {{CC}} {{BASE}} {{SAN}} {{flags}} -o "$out/$s" "{{SRC}}/$s.c"
    done

[unix]
[private]
run tag suites=SUITES:
    #!/usr/bin/env bash
    set -uo pipefail
    failfile='{{BUILD}}/{{tag}}.failures'
    : > "$failfile"
    for s in {{suites}}; do
        bin='{{BUILD}}/{{tag}}/'"$s"
        echo "=== {{tag}}/$s ==="
        for t in $("$bin" --list); do
            if "$bin" "@$t"; then
                :
            else
                echo "*** FAILED: $s::$t" >&2
                echo "$s::$t" >> "$failfile"
            fi
        done
    done
    # do not fail here: check must still run the other backend(s)
    exit 0

# fail if any recorded test failed; `tags` is a space separated list
[unix]
[private]
verify tags:
    #!/usr/bin/env bash
    set -uo pipefail
    nfail=0
    for tag in {{tags}}; do
        f='{{BUILD}}/'"$tag"'.failures'
        [ -f "$f" ] || continue
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            echo "FAILED: $tag/$line" >&2
            nfail=$((nfail + 1))
        done < "$f"
    done
    if [ "$nfail" -ne 0 ]; then
        echo "" >&2
        echo "$nfail test(s) failed (see the FAIL lines above)" >&2
        exit 1
    fi
    echo "all suites passed"

# ---------------------------------------------------------------------------
# checks

# build + run every suite on the native backend and on select
[unix]
check: (build "native" "") (run "native") (build "select" "-DZN_USE_SELECT") (run "select") (verify "native select")

# native backend only
[unix]
check-native: (build "native" "") (run "native") (verify "native")

# select backend only
[unix]
check-select: (build "select" "-DZN_USE_SELECT") (run "select") (verify "select")

# alias: ASan+UBSan is the default for `check`
[unix]
check-asan: check

# one suite, native backend: `just test tcp`, `just test tcp tcp_connect`
[unix]
test name *args='':
    #!/usr/bin/env bash
    set -euo pipefail
    suite='{{name}}'
    case "$suite" in
        *_test) ;;
        *) suite="${suite}_test" ;;
    esac
    out='{{BUILD}}/native'
    mkdir -p "$out"
    {{LUA}} '{{ROOT}}/misc/gen_entries.lua' \
        "{{SRC}}/$suite.c" "{{SRC}}/$suite.gen.inc" {{GEN_DEFS}}
    {{CC}} {{BASE}} {{SAN}} -o "$out/$suite" "{{SRC}}/$suite.c"
    "$out/$suite" {{args}}

# one suite, select backend
[unix]
test-select name *args='':
    #!/usr/bin/env bash
    set -euo pipefail
    suite='{{name}}'
    case "$suite" in
        *_test) ;;
        *) suite="${suite}_test" ;;
    esac
    out='{{BUILD}}/select'
    mkdir -p "$out"
    {{LUA}} '{{ROOT}}/misc/gen_entries.lua' \
        "{{SRC}}/$suite.c" "{{SRC}}/$suite.gen.inc" -DZN_USE_SELECT {{GEN_DEFS}}
    {{CC}} {{BASE}} {{SAN}} -DZN_USE_SELECT -o "$out/$suite" "{{SRC}}/$suite.c"
    "$out/$suite" {{args}}

# Build znet.so from zn_lua.c on a private build dir, then run `script`.
# Needs Lua >= 5.3 and its headers (pkg-config name lua5.5/5.4/5.3/lua).  Kept
# out of `check`: the binding is optional and links against the host's Lua ABI.
[unix]
[private]
lua-run script=TEST_LUA:
    #!/usr/bin/env bash
    set -euo pipefail
    out='{{BUILD}}/lua'
    mkdir -p "$out"
    inc="${LUA_INC:-$(pkg-config --cflags lua5.5 lua5.4 lua5.3 lua 2>/dev/null || true)}"
    case "$(uname -s)" in
        Darwin) shlib='-bundle -undefined dynamic_lookup' ;;
        *)      shlib='-shared' ;;
    esac
    # -D_XOPEN_SOURCE=600 as in BASE: under -std=c99 glibc hides addrinfo,
    # which zn_addrinfo.h uses.  macOS exposes it without the macro.
    {{CC}} -std=c99 -D_XOPEN_SOURCE=600 -O2 -fPIC $shlib -pthread $inc \
        -I'{{ROOT}}' -o "$out/znet.so" '{{ROOT}}/zn_lua.c'
    # some Lua builds only honour the versioned variable
    LUA_CPATH="$out/?.so" \
    LUA_CPATH_5_5="$out/?.so" LUA_CPATH_5_4="$out/?.so" \
    LUA_CPATH_5_3="$out/?.so" \
        {{LUA}} '{{script}}'

# Lua binding smoke test: see lua-run (tests/test.lua).
[unix]
test-lua: lua-run

# strict Clean C compile check (no run).  Covers the suites, examples/example.c
# and the optional headers that carry their own implementation.  zn_lua.c is
# exempt (C4): it must include Lua headers, which use long long, so its build
# is C99.
[unix]
check-c89:
    #!/usr/bin/env bash
    set -uo pipefail
    fail=0
    mkdir -p '{{BUILD}}'
    for s in {{SUITES}}; do
        echo "--- c89 $s ---"
        {{LUA}} '{{ROOT}}/misc/gen_entries.lua' \
            "{{SRC}}/$s.c" "{{SRC}}/$s.gen.inc" {{GEN_DEFS}}
        {{CC}} -std=c89 -pedantic-errors -Wno-variadic-macros \
            -D_XOPEN_SOURCE=600 {{INC}} \
            -c -o /dev/null "{{SRC}}/$s.c" || fail=1
    done
    for f in example; do
        echo "--- c89 examples/$f.c ---"
        {{CC}} -std=c89 -pedantic-errors -Wno-variadic-macros \
            -D_XOPEN_SOURCE=600 {{INC}} \
            -c -o /dev/null "{{ROOT}}/examples/$f.c" || fail=1
    done
    for h in zn_task; do
        echo "--- c89 $h.h ---"
        printf '#define ZN_IMPLEMENTATION\n#include "%s.h"\n' "$h" \
            > '{{BUILD}}/check_'"$h"'.c'
        {{CC}} -std=c89 -pedantic-errors -D_XOPEN_SOURCE=600 {{INC}} \
            -pthread -c -o /dev/null '{{BUILD}}/check_'"$h"'.c' || fail=1
    done
    exit $fail

# strict C++03 compile check (no run)
[unix]
check-cpp03:
    #!/usr/bin/env bash
    set -uo pipefail
    fail=0
    for s in {{SUITES}}; do
        echo "--- c++03 $s ---"
        {{LUA}} '{{ROOT}}/misc/gen_entries.lua' \
            "{{SRC}}/$s.c" "{{SRC}}/$s.gen.inc" {{GEN_DEFS}}
        {{CXX}} -std=c++03 -pedantic-errors -Wno-variadic-macros \
            -D_XOPEN_SOURCE=600 {{INC}} \
            -x c++ -c -o /dev/null "{{SRC}}/$s.c" || fail=1
    done
    for f in example; do
        echo "--- c++03 examples/$f.c ---"
        {{CXX}} -std=c++03 -pedantic-errors -Wno-variadic-macros \
            -D_XOPEN_SOURCE=600 {{INC}} \
            -x c++ -c -o /dev/null "{{ROOT}}/examples/$f.c" || fail=1
    done
    for h in zn_task; do
        echo "--- c++03 $h.h ---"
        printf '#define ZN_IMPLEMENTATION\n#include "%s.h"\n' "$h" \
            > '{{BUILD}}/check_'"$h"'.c'
        {{CXX}} -std=c++03 -pedantic-errors -D_XOPEN_SOURCE=600 {{INC}} \
            -pthread -x c++ -c -o /dev/null '{{BUILD}}/check_'"$h"'.c' || fail=1
    done
    exit $fail

# MSVC /W4 /WX is a Windows-only check; do not silently pass elsewhere.
[unix]
check-msvc:
    #!/usr/bin/env bash
    echo "check-msvc: cl /W4 /WX requires Windows + MSVC." >&2
    echo "Not verified on this host; run this target on the Windows CI job." >&2
    exit 2

# ---------------------------------------------------------------------------
# coverage (lcov)

[unix]
[private]
cov-build tag flags:
    #!/usr/bin/env bash
    set -uo pipefail
    out='{{BUILD}}/{{tag}}'
    # macOS and the Linux VM share this directory: a .gcda written by the
    # other platform's compiler makes lcov abort on a version mismatch
    rm -rf "$out"
    mkdir -p "$out"
    nfail=0
    for s in {{SUITES}}; do
        {{LUA}} '{{ROOT}}/misc/gen_entries.lua' \
            "{{SRC}}/$s.c" "{{SRC}}/$s.gen.inc" {{flags}} {{GEN_DEFS}}
        {{CC}} {{BASE}} {{flags}} -g -O0 --coverage \
            -o "$out/$s" "{{SRC}}/$s.c"
        # one process per test: a failing test loses only its own coverage
        for t in $("$out/$s" --list); do
            ( cd "$out" && ./"$s" "@$t" ) || {
                echo "COV: $s::$t FAILED (assert or known library bug)" >&2
                nfail=$((nfail + 1))
            }
        done
    done
    echo "COV: $nfail test(s) failed; coverage still collected"
    exit 0

# build + run everything with --coverage, then merge into one report
[unix]
cov: (cov-build "cov-native" "") (cov-build "cov-select" "-DZN_USE_SELECT") cov-report

[unix]
[private]
cov-report:
    #!/usr/bin/env bash
    set -euo pipefail
    cd '{{BUILD}}'
    lcov --capture --directory cov-native --rc branch_coverage=1 \
        --ignore-errors inconsistent,unsupported,empty,corrupt \
        --output-file native.info
    lcov --capture --directory cov-select --rc branch_coverage=1 \
        --ignore-errors inconsistent,unsupported,empty,corrupt \
        --output-file select.info
    lcov --extract native.info '*/znet.h' --rc branch_coverage=1 \
        --ignore-errors inconsistent,unused,corrupt --output-file znet-native.info
    lcov --extract select.info '*/znet.h' --rc branch_coverage=1 \
        --ignore-errors inconsistent,unused,corrupt --output-file znet-select.info
    echo "=== znet.h coverage (native backend) ==="
    lcov --list znet-native.info --rc branch_coverage=1 \
        --ignore-errors inconsistent,corrupt || true
    echo "=== znet.h coverage (select backend) ==="
    lcov --list znet-select.info --rc branch_coverage=1 \
        --ignore-errors inconsistent,corrupt || true
    lcov --add-tracefile native.info --add-tracefile select.info \
        --rc branch_coverage=1 --ignore-errors inconsistent,corrupt \
        --output-file coverage.info
    lcov --extract coverage.info '*/znet.h' '*/znet.hpp' '*/zn_buffer.h' \
        --rc branch_coverage=1 --ignore-errors inconsistent,unused,corrupt \
        --output-file znet.info
    echo "=== znet.h coverage (kqueue/epoll + select merged) ==="
    lcov --list znet.info --rc branch_coverage=1 \
        --ignore-errors inconsistent,corrupt || true

# lines with zero coverage in znet.h (znet.info also carries zn_buffer.h)
[unix]
cov-lines:
    @awk '/^SF:/{z=($0 ~ /\/znet\.h$/)} z && /^DA:/ && /,0$/ {gsub(/DA:|,0/,""); print}' \
        '{{BUILD}}/znet.info' | sort -n | while read -r ln; do \
        src=$(sed -n "${ln}p" '{{ROOT}}/znet.h' 2>/dev/null); \
        case "$src" in *assert*) ;; *) echo "L$ln: $src";; esac; \
    done

# uncovered lines from the last `just cov`, grouped by function (znet.h +
# zn_buffer.h).  Reads the functions' hit counts (FNA/FNDA) for the headers.
[unix]
uncovered:
    #!/usr/bin/env bash
    set -euo pipefail
    info='{{BUILD}}/znet.info'
    if [ ! -f "$info" ]; then
        echo "no coverage data at $info" >&2
        echo "run 'just cov' first" >&2
        exit 1
    fi
    for f in '{{ROOT}}/znet.h' '{{ROOT}}/zn_buffer.h'; do
        if [ "$f" -nt "$info" ]; then
            echo "warning: $f is newer than $info; line numbers are stale" >&2
        fi
    done
    {{LUA}} '{{ROOT}}/misc/uncovered.lua' "$info"

# branches taken zero times in znet.h (znet.info also carries zn_buffer.h)
[unix]
cov-unbranched:
    @awk -F'[:,]' '/^SF:/{z=($0 ~ /\/znet\.h$/)} z && /^BRDA:/ && $5==0 {print $2}' \
        '{{BUILD}}/znet.info' | sort -n -u | while read -r ln; do \
        src=$(sed -n "${ln}p" '{{ROOT}}/znet.h' 2>/dev/null); \
        case "$src" in *assert*) ;; *) printf "L%-5d %s\n" "$ln" "$src";; esac; \
    done

# ---------------------------------------------------------------------------
# cleanup

# remove the coverage data and reports, keep the compiled binaries
[unix]
clean-cov:
    rm -rf '{{BUILD}}'/cov-*
    rm -f '{{BUILD}}'/*.info '{{BUILD}}'/coverage.info

[unix]
clean:
    rm -rf '{{BUILD}}'
    rm -f '{{SRC}}'/*.gen.inc

# ---------------------------------------------------------------------------
# windows / MSVC
#
# The logic lives in tests\check.bat and tests\run.bat so it also works from a
# Developer Command Prompt without just; these recipes only dispatch.  znet.h
# always uses IOCP on _WIN32, so there is no select pass to run there; MSVC has
# no -pedantic equivalent, so check-c89/check-cpp03 stay POSIX-only.

[windows]
check:
    @call "{{SRC}}\check.bat"

[windows]
check-native:
    @call "{{SRC}}\check.bat" native

[windows]
check-select:
    @call "{{SRC}}\check.bat" select

[windows]
check-asan: check

[windows]
check-msvc:
    @call "{{SRC}}\check.bat"

[windows]
check-c89:
    @echo check-c89 needs gcc/clang; use "just check-msvc" for cl /W4 /WX.

[windows]
check-cpp03:
    @echo check-cpp03 needs g++/clang; use "just check-msvc" for cl /W4 /WX.

[windows]
test name *args='':
    @call "{{SRC}}\run.bat" {{name}} {{args}}

[windows]
test-select name *args='':
    @call "{{SRC}}\run.bat" {{name}} -select {{args}}

[windows]
clean:
    @if exist "{{BUILD}}" rmdir /s /q "{{BUILD}}"
    @if exist "{{SRC}}\*.gen.inc" del /q "{{SRC}}\*.gen.inc"
